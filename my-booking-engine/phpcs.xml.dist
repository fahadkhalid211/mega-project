<?xml version="1.0"?>
<ruleset name="Booking Engine WordPress Standards">
	<description>PHP_CodeSniffer ruleset for Booking Engine WordPress Plugin.</description>

	<!-- Scan all files in plugin -->
	<file>.</file>

	<!-- Exclude build artifacts and vendor directories -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/js/*.min.js</exclude-pattern>
	<exclude-pattern>/assets/css/*.min.css</exclude-pattern>

	<!-- Arguments -->
	<arg name="basepath" value="."/>
	<arg name="parallel" value="8"/>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>

	<!-- Include WordPress Coding Standards -->
	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<!-- Minimum supported PHP version -->
	<config name="testVersion" value="7.4-"/>

	<!-- Text domain check -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="my-booking-engine"/>
			</property>
		</properties>
	</rule>
</ruleset>
